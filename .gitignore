# --- Corpus data policy ---
# raw and interim are bulky and re-creatable (fetch-once rule + backup drive);
# processed CSVs, manifest.jsonl, failed.csv, and fixtures/ ARE committed.
data/raw/*
data/interim/*
!data/raw/.gitkeep
!data/interim/.gitkeep

# Backups / large local artifacts
*.zip
*.tar.gz

# --- Python / uv ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Jupyter (if you add exploratory notebooks) ---
.ipynb_checkpoints/

# --- Secrets & local config ---
.env
.env.*
!.env.example

# --- Claude Code local state ---
.claude/settings.local.json

# --- Editor / OS noise ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
